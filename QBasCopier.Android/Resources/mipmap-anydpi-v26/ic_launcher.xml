<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono adaptativo. El foreground SI lleva la marca: antes estaba en
  @android:color/transparent, y en Android 8+ eso dejaba el icono con solo el
  fondo recortado, que es justo el defecto que se quejaba (marca partida).
  El fondo y la marca son los dos vectores nuevos, no los PNG de cada densidad.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
