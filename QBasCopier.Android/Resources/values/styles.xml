<resources>
  <!--
    AvaloniaMainActivity deriva de AppCompatActivity. AppCompat valida en onPostCreate
    que el tema traiga windowActionBar; si el estilo no es descendiente de Theme.AppCompat
    (o su parent no resuelve tras el merge de recursos) revienta con:
      "You need to use a Theme.AppCompat theme (or descendant) with this activity."
    Por eso el estilo se declara aqui de forma explicita y MainActivity.OnCreate tambien
    hace SetTheme(Resource.Style.MyTheme) antes de base.OnCreate.
  -->
  <style name="MyTheme" parent="Theme.AppCompat.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="windowActionModeOverlay">true</item>
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:windowDisablePreview">true</item>
  </style>
</resources>
