<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.qbaswing.qbascopier</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <RootNamespace>QBasCopier</RootNamespace>
    <AssemblyName>QBasCopier</AssemblyName>
    <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
    <!-- arm64 (modernos) + armv7 (viejos/tabletas baratas) + x64 (emuladores) = instalable en practicamente todo.
         OJO: antes se usaba AndroidSupportedAbis, que el SDK ya ignora (warning XA0036), por eso el
         APK anterior pesaba 42 MB con todas las ABIs dentro. -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.5" />
    <PackageReference Include="Avalonia.Android" Version="11.3.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.5" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.5" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <!-- Version explicita y unica de AppCompat: si el merge trae dos versiones,
         AppCompatDelegateImpl busca sus attrs (windowActionBar) con indices que no
         coinciden con la tabla de recursos fusionada y lanza el IllegalStateException
         "You need to use a Theme.AppCompat theme (or descendant) with this activity". -->
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.1" />
    <AndroidResource Include="Resources/values/styles.xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../QBasCopier/*.cs" Exclude="../QBasCopier/ExplorerIntegration.cs" />
    <AvaloniaResource Include="../QBasCopier/Assets/*.png" />
    <AvaloniaXaml Include="../QBasCopier/App.axaml" Link="App.axaml" />
    <AvaloniaXaml Include="../QBasCopier/MainWindow.axaml" Link="MainWindow.axaml" />
  </ItemGroup>
</Project>