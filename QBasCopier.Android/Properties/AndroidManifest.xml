<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- RED: imprescindible. Sin android.permission.INTERNET toda la parte de
       transferencia (TCP 9527 + descubrimiento UDP 9528) falla al arrancar, y la
       app no muestra ni siquiera un aviso: la excepcion se traga en Discovery/TransferHost. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
  <!-- Mantiene la CPU y el WiFi vivos durante una transferencia o copia larga
       con la pantalla apagada. No es una excepcion en tiempo de ejecucion. -->
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation"/>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <!-- required="false": si fuese true, la Play Store / el instalador bloquea la app
       en dispositivos sin WiFi (tabletas, algunos emuladores). -->
  <uses-feature android:name="android.hardware.wifi" android:required="false"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <!--
    NO se declaran <activity> aqui a proposito: los generan los atributos [Activity] de
    MainActivity.cs, que ademas son los unicos que llevan android:theme y el
    intent-filter MAIN/LAUNCHER. Declararlos aqui creaba Activities fantasma
    (com.qbaswing.qbascopier.MainActivity) apuntando a clases inexistentes.
  -->

  <!--
    El servicio en primer plano es lo unico que Android respeta para seguir
    copiando con la pantalla apagada: sin el, el sistema mata el proceso en
    segundo plano aunque se pida WakeLock y la copia se queda a medias.
    FOREGROUND_SERVICE (API 28+) y FOREGROUND_SERVICE_DATA_SYNC (API 34+, donde
    Android 14 separa por tipo) son obligatorios a partir de esas versiones.
    POST_NOTIFICATIONS (API 33+) es lo que hace que se vea la notificacion y
    RECEIVE_BOOT_COMPLETED deja pendiente una copia si el telefono se apaga.
    Ojo: los <uses-permission> van como hijos directos de <manifest>, nunca
    dentro de <application>, que es donde se habian puesto al principio y
    hacia fallar la build.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

  <application android:label="QBasWing Shuttle · QBasCopier y Transfer"
               android:theme="@style/MyTheme"
               android:icon="@mipmap/ic_launcher"
               android:roundIcon="@mipmap/ic_launcher_round"
               android:allowBackup="true"
               android:usesCleartextTraffic="true"
               android:enableOnBackInvokedCallback="false"
               android:hardwareAccelerated="true"
               android:largeHeap="true">

    <!--
      El servicio en primer plano es lo unico que Android respeta para seguir
      copiando con la pantalla apagada: sin el, el sistema mata el proceso en
      segundo plano aunque se pida WakeLock y la copia se queda a medias.
    -->
    <service
        android:name=".CopyService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />

    <!-- Para abrir una carpeta o un archivo con otra app sin pedir permisos. -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
