<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QBasCopier"
             x:Class="QBasCopier.MainWindow"
             Background="{DynamicResource BgBase}">
    <!-- UserControl y no Window: en Android Avalonia no permite construir un Window
         (WindowingPlatformStub.CreateWindow lanza NotSupportedException), asi que la
         UI tiene que ser un Control. En escritorio lo envuelve DesktopWindow.

         La marca de agua y el pie los dibuja MainWindow.BuildBrandCredit() replicando
         el bloque .brand-credit de QBasWing MyServer: fijo abajo a la izquierda,
         dos lineas, transparente pero legible, y sin capturar toques. -->
    <Panel>
        <Grid x:Name="Root"/>
    </Panel>
</UserControl>
