<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:QBasCopier"
        x:Class="QBasCopier.MainWindow"
        Title="QBasCopier"
        Width="1220" Height="760"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Panel Background="{DynamicResource BgBase}">
        <Grid x:Name="Root" Margin="2"/>
        <TextBlock x:Name="Watermark" Text="QBasCopier" FontSize="150" FontWeight="Bold"
                   Foreground="{DynamicResource Water}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
        <TextBlock x:Name="WaterFooter" Text="QBasCopier · © 2026"
                   FontSize="15" Foreground="{DynamicResource Water}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,6"
                   IsHitTestVisible="False"/>
    </Panel>
</Window>