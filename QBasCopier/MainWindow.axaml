<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:QBasCopier"
        x:Class="QBasCopier.MainWindow"
        Title="QBasCopier&amp;Transfer"
        SystemDecorations="Full"
        Width="1220" Height="760"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Panel Background="{DynamicResource BgBase}">
        <Grid x:Name="Root" Margin="2"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False" Spacing="8">
            <TextBlock x:Name="Watermark" Text="QBasCopier&amp;Transfer" FontSize="120" FontWeight="Bold"
                       Foreground="{DynamicResource Water}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Asociado con Freeman y Diseños" FontSize="26"
                       Foreground="{DynamicResource Water}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="WaterFooter" Text="QBasCopier&amp;Transfer · © 2026 · Asociado con Freeman y Diseños"
                   FontSize="15" Foreground="{DynamicResource Water}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,6"
                   IsHitTestVisible="False"/>
    </Panel>
</Window>